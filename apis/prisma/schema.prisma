generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  VET
  ADMIN
}

enum AnimalStatus {
  HEALTHY
  SICK
  PREGNANT
  SOLD
  DECEASED
}

enum Gender {
  MALE
  FEMALE
}

enum RiskLevel {
  NORMAL
  VET_SOON
  EMERGENCY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String             @default("123456")
  phoneNumber       String             @unique
  role              Role               @default(FARMER)
  location          String?
  fcmToken          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  livestock         Livestock[]
  consultations     TeleConsultation[] @relation("FarmerConsultations")
  vetConsultations  TeleConsultation[] @relation("VetConsultations")
  financialRecords  FinancialRecord[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  vetProfile        VetProfile?
  appointmentSlots  AppointmentSlot[]  @relation("VetSlots")
  reviewsReceived   VetReview[]        @relation("VetReviews")
  reviewsGiven      VetReview[]        @relation("FarmerReviews")

  sentMessages      ChatMessage[]      @relation("SentMessages")
  receivedMessages  ChatMessage[]      @relation("ReceivedMessages")

  @@map("users")
}

model VetProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber    String   @unique
  specialization   String
  experienceYears  Int      @default(0)
  consultationFee  Float    @default(0)
  availableFrom    String   @default("09:00")
  availableTo      String   @default("18:00")
  availableDays    String[]
  bio              String?
  profileImageUrl  String?
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  isVerified       Boolean  @default(false)
  isAvailable      Boolean  @default(true)
  latitude         Float?
  longitude        Float?
  district         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("vet_profiles")
}

model AppointmentSlot {
  id           String            @id @default(uuid())
  vetId        String
  vet          User              @relation("VetSlots", fields: [vetId], references: [id], onDelete: Cascade)
  date         DateTime
  startTime    String
  endTime      String
  isBooked     Boolean           @default(false)
  consultation TeleConsultation?
  createdAt    DateTime          @default(now())

  @@map("appointment_slots")
}

model VetReview {
  id        String   @id @default(uuid())
  vetId     String
  vet       User     @relation("VetReviews", fields: [vetId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    User     @relation("FarmerReviews", fields: [farmerId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([vetId, farmerId])
  @@map("vet_reviews")
}

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  nameBn    String
  division  String
  createdAt DateTime @default(now())

  @@map("districts")
}

model Livestock {
  id                String             @id @default(uuid())
  farmerId          String
  farmer            User               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name              String?
  species           String
  breed             String
  dateOfBirth       DateTime
  gender            Gender
  weight            Float
  status            AnimalStatus       @default(HEALTHY)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  smartCollar       SmartCollar?
  healthAssessments HealthAssessment[]
  vaccinations      Vaccination[]

  @@map("livestock")
}

model SmartCollar {
  id            String    @id @default(uuid())
  livestockId   String?   @unique
  livestock     Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  deviceCode    String    @unique
  batteryLevel  Int       @default(100)
  isOnline      Boolean   @default(true)
  lastHeartRate Float?
  lastBodyTemp  Float?
  lastStepCount Int?
  lastLatitude  Float?
  lastLongitude Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  locations     CollarLocation[]

  @@map("smart_collars")
}

model CollarLocation {
  id          String      @id @default(uuid())
  collarId    String
  collar      SmartCollar @relation(fields: [collarId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  altitude    Float?
  speed       Float?
  course      Float?
  satellites  Int?
  fixQuality  String?
  recordedAt  DateTime
  createdAt   DateTime    @default(now())

  @@index([collarId, recordedAt])
  @@map("collar_locations")
}

model HealthAssessment {
  id             String    @id @default(uuid())
  livestockId    String
  livestock      Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  imageUrl       String?
  riskLevel      RiskLevel @default(NORMAL)
  diagnosisNotes String?
  symptoms       String[]
  assessedAt     DateTime  @default(now())

  @@map("health_assessments")
}

model Vaccination {
  id               String    @id @default(uuid())
  livestockId      String
  livestock        Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  vaccineName      String
  scheduledDate    DateTime
  administeredDate DateTime?
  isDone           Boolean   @default(false)
  notes            String?

  @@map("vaccinations")
}

model TeleConsultation {
  id            String             @id @default(uuid())
  farmerId      String
  farmer        User               @relation("FarmerConsultations", fields: [farmerId], references: [id], onDelete: Cascade)
  vetId         String
  vet           User               @relation("VetConsultations", fields: [vetId], references: [id], onDelete: Cascade)
  slotId        String?            @unique
  slot          AppointmentSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  status        ConsultationStatus @default(PENDING)
  scheduledTime DateTime
  prescription  String?
  notes         String?
  roomId        String?
  callStatus    String             @default("NOT_STARTED")
  createdAt     DateTime           @default(now())

  @@map("tele_consultations")
}

model FinancialRecord {
  id          String          @id @default(uuid())
  farmerId    String
  farmer      User            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Float
  category    String
  description String?
  date        DateTime        @default(now())

  @@map("financial_records")
}

model CommunityPost {
  id         String             @id @default(uuid())
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   String             @default("GENERAL")
  imageUrl   String?
  likesCount Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  comments   CommunityComment[]
  likes      CommunityLike[]

  @@map("community_posts")
}

model CommunityLike {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@map("community_likes")
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())

  @@map("community_comments")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("chat_messages")
}

